+package io.apocalypse.probe.api;
+
+import io.apocalypse.framework.capability.CapabilityRegistry;
+import io.apocalypse.probe.application.ProbeRuntime;
+
+import org.springframework.beans.factory.ObjectProvider;
+
+public class ProbeFacade {
+  public static final String KEY = "probe";
+
+  private final CapabilityRegistry capabilities;
+
+  private final ObjectProvider<ProbeRuntime> runtime;
+
+  public ProbeFacade(CapabilityRegistry capabilities, ObjectProvider<ProbeRuntime> runtime) {
+    this.capabilities = capabilities;
+    this.runtime = runtime;
+  }
+
+  public ProbeStatus status() {
+    capabilities.requireEnabled(KEY, 11000, "验收模块已关闭");
+    return new ProbeStatus(runtime.getObject().rows());
+  }
+}
