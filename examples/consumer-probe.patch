@@ -0,0 +1,28 @@
+import { useQuery } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+
+import { ModuleAccess } from '@/lib/query/ModuleAccess'
+
+export { probeScope as queryScope } from './probe.queries'
+import { probeQueries, probeScope } from './probe.queries'
+
+function ProbeOverview() {
+  const { t } = useTranslation('probe')
+  const status = useQuery(probeQueries.status({}))
+  return (
+    <main className="p-6">
+      <h1>{t('title')}</h1>
+      <p role="status">
+        {status.isPending
+          ? t('loading')
+          : status.isError
+            ? t('error')
+            : t('rows', { rows: status.data.rows })}
+      </p>
+    </main>
+  )
+}
+
+export default function ProbePage() {
+  return <ModuleAccess scope={probeScope} component={ProbeOverview} />
+}
